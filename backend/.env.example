# ============================================================
# 《模拟面试AI助手》后端环境变量示例
# ============================================================
# 复制本文件为 .env 并按需修改。
#
# 数据库说明：
#   - 默认不配 DB_URL 时，后端自动使用 SQLite（./mock_interview.db），零配置启动。
#   - 切换 MySQL：先执行建表脚本  sql/mock_interview_schema.sql
#       mysql -u root -p < sql/mock_interview_schema.sql
#     再把下面的 DB_URL 用户名/密码改成你本机的 MySQL 账号即可。
# ============================================================

# 数据库连接 (MySQL 8.0+)
DB_URL=mysql+pymysql://root:root@127.0.0.1:3306/mock_interview?charset=utf8mb4

# JWT 配置
# 部署前必须换成随机字符串，例如：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_this_to_a_random_256bit_secret_key_please_xxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 大模型（DeepSeek，OpenAI 兼容协议）
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60
DIALOG_MEMORY_TURNS=10

# 运行环境
ENV=dev
DEBUG=true

# 允许跨域的前端地址，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# 演示账号（面试官体验用，不需要真实短信）
DEMO_LOGIN_ENABLED=true
DEMO_PHONE=18888888888
DEMO_NICKNAME=演示用户

# 上传与输入限制
MAX_UPLOAD_MB=10
MAX_ANSWER_CHARS=5000
MAX_QUESTIONS_PER_SESSION=60

# 短信验证码（阿里云号码认证服务 - 短信认证）
SMS_CODE_EXPIRE_SECONDS=300
SMS_SEND_INTERVAL_SECONDS=60
SMS_FREE_SEND_COUNT=3
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_ENDPOINT=dypnsapi.aliyuncs.com
SMS_DEBUG_RETURN_CODE=true
